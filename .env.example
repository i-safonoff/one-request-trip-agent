# Copy to .env (cp .env.example .env). Everything has a working default except the GigaChat key.

# --- app
# docker compose sets DATABASE_URL (postgresql+asyncpg://app:app@db:5432/app) itself.
# Without Docker the default is a local SQLite file; for PostgreSQL: postgresql+asyncpg://user:password@host:5432/db
# DATABASE_URL=
# Signs API session tokens (guest and Telegram sessions). Long random string; compose falls back to a dev value.
SESSION_SECRET=change-me-in-production

# --- LLM: GigaChat (https://developers.sber.ru/docs/ru/gigachat/api/authorization)
# "Authorization key" from the GigaChat API project. Without it the app starts but cannot answer messages.
GIGACHAT_AUTH_KEY=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_MODEL=GigaChat-2-Max
# empty = the SDK default endpoint
GIGACHAT_BASE_URL=
# The GigaChat endpoint uses the Russian trusted root CA, which is not in the default store.
# false = skip verification (convenient for a demo); for strict TLS install the CA and set GIGACHAT_CA_BUNDLE_FILE.
GIGACHAT_VERIFY_SSL_CERTS=false
GIGACHAT_CA_BUNDLE_FILE=
# parallel LLM requests (check the limit of your tariff)
# 1 for the free personal tier: parallel requests get 429
GIGACHAT_MAX_CONCURRENCY=1
# one agent run is stopped after this many seconds (a hung model or source call), the saved checkpoints stay
RUN_DEADLINE_SECONDS=150
# true = ask GigaChat for json_schema response_format (it flattens nested schemas, so off by default)
GIGACHAT_JSON_SCHEMA=false

# --- data sources
# Hotels and transport, three modes:
#   auto = live data from the Tutu MCP; if it is unreachable (it answers Russian IPs only) or has nothing for a
#          route, the gap is filled with synthetic data labelled "демо" everywhere (UI badge, plan, answer)
#   tutu = live only, a failure is reported as a failure
#   mock = synthetic only
HOTELS_SOURCE=auto
TUTU_MCP_URL=https://mcp.tutu.ru/mcp
TRANSPORT_SOURCE=auto
# "warm sea" threshold for the destination agent, °C (Open-Meteo sea-surface temperature)
WARM_SEA_MIN_C=22
# geocoding of places that are not in the built-in catalog (OpenStreetMap Nominatim, cached)
NOMINATIM_ENABLED=true

# --- map (see backend/trip_map/README.md): maplibre (default, no key) | leaflet | google
TRIP_MAP_PROVIDER=maplibre
TRIP_MAP_LANGUAGE=ru

# --- Telegram (optional; the web UI at http://localhost:8080 works without it)
# Token from @BotFather. With it the app starts the bot: long polling by default (no public address needed).
TELEGRAM_BOT_TOKEN=
# Public HTTPS origin of this backend: Telegram opens the Mini App (the web UI) only from https. Use the
# SSH tunnel of the `telegram` compose profile (it writes its address into a shared file that overrides this value) or your own domain.
PUBLIC_BASE_URL=http://localhost:8080
# Permanent Mini App address through ngrok (docker compose --profile ngrok up -d): one free static domain per account
NGROK_AUTHTOKEN=
NGROK_DOMAIN=
# Webhook instead of long polling (production): both must be set
TELEGRAM_WEBHOOK_URL=
TELEGRAM_WEBHOOK_SECRET=
# Keep false: the stub agent answers with mock data and would compete with the real worker
DEV_AGENT=false

# --- trip history (see docs/trip-templates.md)
# accept feedback before the trip ends (demo trips are in the future); off in production
HISTORY_ALLOW_EARLY_FEEDBACK=false
HISTORY_HALF_LIFE_DAYS=365
HISTORY_MIN_CONFIDENCE=0.4

# --- compose
# Set to linux/arm64 to run natively on Apple Silicon (the rules ask for linux/amd64 by default)
DOCKER_PLATFORM=linux/amd64
